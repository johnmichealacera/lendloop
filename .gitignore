# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# convex local backend data
.convex/

# AI agent skills installed by the Convex CLI (reinstall with `npx convex ai-files install`)
/.agents/
/.claude/
/skills-lock.json

# n8n local data: credentials, encryption key, executions (docker volume)
/n8n/data/
/n8n_data/

# test reports
/test-results/
/playwright-report/
/coverage/

# logs
*.log
logs/

# editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
