# Copied to n8n/.env by scripts/n8n-init.sh, which fills the secrets with random values.
# n8n/.env is git-ignored. Never commit real values.

# Encrypts the credentials n8n stores in its volume. Losing it makes saved credentials unreadable.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila

# Public base URL of n8n webhooks (the tunnel). Written by scripts/n8n-tunnel.sh; empty means http://localhost:5678.
N8N_WEBHOOK_URL=

# Convex HTTP actions base, e.g. https://<deployment>.convex.site (NEXT_PUBLIC_CONVEX_SITE_URL in .env.local).
CONVEX_SITE_URL=

# Convex -> n8n: Convex signs webhook bodies with this; n8n verifies. Same value as Convex env N8N_WEBHOOK_SECRET.
N8N_WEBHOOK_SECRET=

# n8n -> Convex: n8n signs calls to Convex with this; Convex verifies. Same value as Convex env CONVEX_CALLBACK_SECRET.
CONVEX_CALLBACK_SECRET=
